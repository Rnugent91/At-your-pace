# /etc/systemd/system/quotes.service
[Unit]
Description=At Your Pace quote builder (quotes.quackport.com)
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/quotes
EnvironmentFile=/etc/quotes.env
Environment=DATA_DIR=/var/lib/quotes
# One worker: research runs as an in-process background task and quotes live in SQLite.
ExecStart=/var/www/quotes/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 5055 --workers 1 --proxy-headers
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
