# Required for live research. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Password for the site (username can be anything). Always set this when the
# app is on a public subdomain such as quotes.quackport.com.
APP_PASSWORD=

# Business details printed on quotes
BUSINESS_NAME=At Your Pace Travel
ADVISOR_NAME=Rachel Pace
# Line under the advisor's name on quotes
ADVISOR_TAGLINE=Travel Advisor · Fora Travel · Atlanta, Georgia
ADVISOR_EMAIL=
ADVISOR_PHONE=
BUSINESS_WEBSITE=

# Default price-tracking service fee (USD) pre-filled on new quotes
DEFAULT_TRACKING_FEE=50

# Days a quote is valid for
QUOTE_VALID_DAYS=7

# Where quotes are stored (SQLite)
DATA_DIR=./data

# ── Royal Caribbean live pricing (same setup Quackport uses) ─────────────────
# RC's website is behind Akamai bot protection, which blocks server IPs. Cloudflare
# Browser Rendering loads the pages in a real browser so room prices and the sailing
# lookup work from a server. Reuse Quackport's CloudflareBrowserRendering values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Add-on prices (drinks, Wi-Fi, excursions, dining...) come from RC's GraphQL API.
# In production Quackport routes this through its Cloudflare Worker (RcclGraphQlUrl
# in appsettings.Production.json); put the same URL here.
RCCL_GRAPHQL_URL=https://aws-prd.api.rccl.com/en/royal/web/graphql

# Claude model used for research and extraction
CLAUDE_MODEL=claude-opus-5

# Optional: path to a Chromium binary if Playwright's bundled one isn't installed
CHROMIUM_PATH=

# DEMO_MODE=1 fills quotes with clearly-labelled SAMPLE data instead of calling
# Claude, so you can try the workflow without an API key.
DEMO_MODE=0
